<%- include('partials/header') %>

<div class="login-wrapper">
  <div class="login-backdrop-glow"></div>
  <div class="login-card-enterprise">
    <div class="login-brand-header">
      <div class="login-logo-glow">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="3"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </div>
      <h2>Zimbra Admin Console</h2>
      <p class="login-subtext">Masuk untuk mengelola akun & server Zimbra</p>
    </div>

    <form method="POST" action="/login" class="login-form-enterprise" id="loginForm">
      <div class="form-group-enterprise">
        <label for="server">Zimbra Server URL</label>
        <div class="input-icon-wrapper">
          <span class="input-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </span>
          <input type="url" id="server" name="server"
                 placeholder="https://zimbra.example.com:7071"
                 value="<%= locals.savedServer || '' %>">
        </div>
        <span class="hint-text">Contoh: https://mail.domain.com:7071 (Kosongkan jika local)</span>
      </div>

      <div class="form-group-enterprise">
        <label for="username">Username Administrator</label>
        <div class="input-icon-wrapper">
          <span class="input-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </span>
          <input type="text" id="username" name="username"
                 placeholder="admin@domain.com" required autocomplete="username">
        </div>
      </div>

      <div class="form-group-enterprise">
        <label for="password">Password</label>
        <div class="input-icon-wrapper">
          <span class="input-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </span>
          <input type="password" id="password" name="password"
                 placeholder="Masukkan password admin" required autocomplete="current-password">
          <button type="button" class="btn-input-action" onclick="togglePasswordVisibility('password')" title="Tampilkan Password">
            👁️
          </button>
        </div>
      </div>

      <div class="form-options-row">
        <label class="custom-checkbox">
          <input type="checkbox" id="rememberServer" name="rememberServer" value="1" checked>
          <span class="checkmark"></span>
          <span class="checkbox-text">Ingat Server URL di Browser</span>
        </label>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-login-submit">
        <span>Masuk ke Admin Console</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </form>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const serverInput = document.getElementById('server');
  const rememberCheckbox = document.getElementById('rememberServer');
  const loginForm = document.getElementById('loginForm');

  const savedServerUrl = localStorage.getItem('zimbra_server_url');
  if (savedServerUrl) {
    serverInput.value = savedServerUrl;
    rememberCheckbox.checked = true;
  }

  loginForm.addEventListener('submit', () => {
    if (rememberCheckbox.checked && serverInput.value.trim()) {
      localStorage.setItem('zimbra_server_url', serverInput.value.trim());
    } else if (!rememberCheckbox.checked) {
      localStorage.removeItem('zimbra_server_url');
    }
  });
});

function togglePasswordVisibility(id) {
  const input = document.getElementById(id);
  if (input) {
    input.type = input.type === 'password' ? 'text' : 'password';
  }
}
</script>

<%- include('partials/footer') %>
