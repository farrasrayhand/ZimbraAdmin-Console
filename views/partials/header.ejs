<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title><%= typeof title !== 'undefined' ? title : 'Zimbra Mobile Admin' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..800;1,9..40,400..800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="<%= typeof activeTab !== 'undefined' ? 'tab-' + activeTab : '' %>">
  <% if (user) { %>
  <header class="app-header">
    <div class="header-content">
      <div class="header-brand">
        <a href="/dashboard" class="brand-link">
          <div class="brand-logo">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="3"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <div class="brand-text">
            <span class="brand-title">Zimbra Admin</span>
            <span class="brand-subtitle">Console</span>
          </div>
        </a>
      </div>

      <nav class="desktop-nav">
        <a href="/dashboard" class="<%= typeof activeTab !== 'undefined' && activeTab === 'dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/accounts" class="<%= typeof activeTab !== 'undefined' && activeTab === 'accounts' ? 'active' : '' %>">Daftar Akun</a>
        <a href="/queue" class="<%= typeof activeTab !== 'undefined' && activeTab === 'queue' ? 'active' : '' %>">Mail Queue</a>
        <a href="/domains" class="<%= typeof activeTab !== 'undefined' && activeTab === 'domains' ? 'active' : '' %>">Domain & COS</a>
      </nav>

      <div class="header-actions">
        <div class="server-status-pill" title="Server Terhubung">
          <span class="status-dot"></span>
          <span class="server-name"><%= user.username ? user.username.split('@')[0] : 'Admin' %></span>
        </div>
        <a href="/logout" class="btn-icon-logout" title="Keluar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </a>
      </div>
    </div>
  </header>
  <% } %>

  <!-- Toast Container -->
  <div class="toast-container" id="toastContainer">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="toast-alert toast-error">
        <div class="toast-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <div class="toast-body">
          <div class="toast-title">Perhatian</div>
          <div class="toast-message"><%= error %></div>
        </div>
        <button type="button" class="toast-close" onclick="dismissToast(this)" aria-label="Tutup">&times;</button>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="toast-alert toast-success">
        <div class="toast-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
        <div class="toast-body">
          <div class="toast-title">Berhasil</div>
          <div class="toast-message"><%= success %></div>
        </div>
        <button type="button" class="toast-close" onclick="dismissToast(this)" aria-label="Tutup">&times;</button>
      </div>
    <% } %>
  </div>

  <main class="container">
