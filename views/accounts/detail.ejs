<%- include('../partials/header') %>

<div class="detail-page-container">
  <!-- Page Header & Back Button -->
  <div class="form-page-header">
    <a href="/accounts" class="btn-back-pill">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>Kembali ke Daftar Akun</span>
    </a>
    <div class="form-title-group">
      <h2>Detail & Kelola Akun</h2>
      <p class="text-muted">Kelola profil, status, alias, kuota storage, dan keamanan akun</p>
    </div>
  </div>

  <!-- Account Overview Card -->
  <div class="detail-card">
    <div class="detail-header">
      <div class="detail-avatar">
        <%= account.name.charAt(0).toUpperCase() %>
      </div>
      <div class="detail-main-info">
        <div class="detail-name"><%= account.attrs.displayName || account.name %></div>
        <div class="text-muted detail-email"><%= account.name %></div>
        <div class="status-badge-container" style="margin-top: 6px;">
          <span class="status-badge status-<%= account.attrs.zimbraAccountStatus || 'active' %>">
            ● <%= (account.attrs.zimbraAccountStatus || 'active').toUpperCase() %>
          </span>
        </div>
      </div>
    </div>

  <!-- Key Attributes Table -->
  <% if (account.attrs) {
       const usedBytes = parseInt(account.attrs.zimbraMailQuotaUsed || account.attrs.zimbraAccountQuotaUsed || 0);
       const totalBytes = parseInt(account.attrs.zimbraMailQuota || 0);
       const usedMB = (usedBytes / 1048576).toFixed(1);
       const totalMB = (totalBytes / 1048576).toFixed(0);
       const percent = totalBytes > 0 ? Math.min(100, Math.round((usedBytes / totalBytes) * 100)) : 0;
  %>
  <div class="detail-attrs">
    <!-- Storage Usage Bar -->
    <div class="storage-usage-block">
      <div class="storage-usage-info">
        <span class="storage-label">💾 Penggunaan Storage</span>
        <span class="storage-numbers">
          <strong><%= usedMB %> MB</strong> <%= totalBytes > 0 ? '/ ' + totalMB + ' MB (' + percent + '%)' : '(COS Default)' %>
        </span>
      </div>
      <% if (totalBytes > 0) { %>
      <div class="quota-progress-track">
        <div class="quota-progress-fill <%= percent > 90 ? 'fill-red' : (percent > 75 ? 'fill-orange' : 'fill-green') %>" style="width: <%= percent %>%;"></div>
      </div>
      <% } %>
    </div>

    <div class="attr-row">
      <span class="attr-key">Nama Depan (First Name)</span>
      <span class="attr-value"><%= account.attrs.givenName || '-' %></span>
    </div>

    <div class="attr-row">
      <span class="attr-key">Nama Tengah (Middle Name)</span>
      <span class="attr-value"><%= account.attrs.initials || '-' %></span>
    </div>

    <div class="attr-row">
      <span class="attr-key">Nama Belakang (Last Name / sn)</span>
      <span class="attr-value"><%= account.attrs.sn || '-' %></span>
    </div>

    <div class="attr-row">
      <span class="attr-key">Class of Service (COS)</span>
      <span class="attr-value">
        <% if (account.attrs.zimbraCOSId && cosList) { %>
          <%= (cosList.find(c => c.id === account.attrs.zimbraCOSId) || {}).name || 'Default COS' %>
        <% } else { %>
          Default COS
        <% } %>
      </span>
    </div>

    <% if (account.attrs.zimbraMailHost) { %>
    <div class="attr-row">
      <span class="attr-key">Mail Host Server</span>
      <span class="attr-value"><%= account.attrs.zimbraMailHost %></span>
    </div>
    <% } %>

    <% if (account.attrs.zimbraPasswordModifiedTime) { %>
    <div class="attr-row">
      <span class="attr-key">Password Diubah</span>
      <span class="attr-value"><%= account.attrs.zimbraPasswordModifiedTime.substring(0, 8) %></span>
    </div>
    <% } %>
  </div>
  <% } %>
</div>

<!-- Change Account Status Action Sheet -->
<div class="section">
  <h3>Status Akun</h3>
  <form method="POST" action="/accounts/<%= encodeURIComponent(account.name) %>/status" class="form-card compact">
    <div class="form-group">
      <label for="accountStatusSelect">Pilih Status Baru</label>
      <select name="status" id="accountStatusSelect" class="form-control" onchange="this.form.submit()">
        <option value="active" <%= (account.attrs.zimbraAccountStatus || 'active') === 'active' ? 'selected' : '' %>>🟢 Active (Aktif Normal)</option>
        <option value="locked" <%= account.attrs.zimbraAccountStatus === 'locked' ? 'selected' : '' %>>🔴 Locked (Terkunci / Blokir Login)</option>
        <option value="closed" <%= account.attrs.zimbraAccountStatus === 'closed' ? 'selected' : '' %>>⚫ Closed (Ditutup)</option>
        <option value="maintenance" <%= account.attrs.zimbraAccountStatus === 'maintenance' ? 'selected' : '' %>>🟠 Maintenance (Perbaikan)</option>
      </select>
    </div>
  </form>
</div>

<!-- Account Aliases Section -->
<div class="section">
  <div class="section-title-row">
    <h3>Email Alias (<%= account.aliases ? account.aliases.length : 0 %>)</h3>
  </div>

  <div class="form-card compact">
    <% if (account.aliases && account.aliases.length > 0) { %>
      <div class="alias-list">
        <% account.aliases.forEach(alias => { %>
          <div class="alias-item">
            <div class="alias-email-badge">
              <span class="alias-icon">📧</span>
              <span class="alias-email-text"><%= alias %></span>
            </div>
            <button type="button" class="btn-remove-alias" onclick="showDeleteAliasModal('<%= alias %>')" title="Hapus alias <%= alias %>">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                <line x1="10" y1="11" x2="10" y2="17"></line>
                <line x1="14" y1="11" x2="14" y2="17"></line>
              </svg>
            </button>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="alias-empty-state">
        <span class="empty-alias-icon">📭</span>
        <span>Belum ada email alias untuk akun ini.</span>
      </div>
    <% } %>

    <form method="POST" action="/accounts/<%= encodeURIComponent(account.name) %>/alias/add" class="add-alias-form">
      <label for="aliasInput" class="alias-form-label">Tambah Email Alias Baru</label>
      <div class="alias-input-row">
        <div class="input-icon-wrapper flex-1">
          <span class="input-icon">📧</span>
          <input type="email" id="aliasInput" name="alias" placeholder="contoh: alias@<%= account.name.includes('@') ? account.name.split('@')[1] : 'domain.com' %>" required autocomplete="off">
        </div>
        <button type="submit" class="btn btn-primary btn-add-alias">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Tambah Alias</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Display Name, Given Name, Initials, SN & COS -->
<div class="section">
  <h3>Edit Profil & Class of Service (COS)</h3>
  <form method="POST" action="/accounts/<%= encodeURIComponent(account.name) %>/modify" class="form-card compact">
    <div class="name-fields-grid" style="margin-bottom: 16px;">
      <div class="form-group" style="margin-bottom: 0;">
        <label for="givenName">Nama Depan (First Name)</label>
        <input type="text" id="givenName" name="givenName" value="<%= account.attrs.givenName || '' %>" placeholder="Nama Depan" autocomplete="off">
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label for="initials">Nama Tengah (Middle Name)</label>
        <input type="text" id="initials" name="initials" value="<%= account.attrs.initials || '' %>" placeholder="Nama Tengah" autocomplete="off">
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label for="sn">Nama Belakang (Last Name) <span class="required-star">*</span></label>
        <input type="text" id="sn" name="sn" value="<%= account.attrs.sn || '' %>" placeholder="Nama Belakang" required autocomplete="off">
      </div>
    </div>

    <div class="form-group">
      <label for="displayName">Nama Tampilan (Display Name)</label>
      <input type="text" id="displayName" name="displayName" value="<%= account.attrs.displayName || '' %>" placeholder="Nama Tampilan" autocomplete="off">
    </div>

    <% if (cosList && cosList.length > 0) { %>
    <div class="form-group">
      <label for="cosId">Class of Service (COS)</label>
      <select name="cosId" id="cosId" class="form-control">
        <option value="">Ikuti Default Server</option>
        <% cosList.forEach(cos => { %>
          <option value="<%= cos.id %>" <%= account.attrs.zimbraCOSId === cos.id ? 'selected' : '' %>><%= cos.name %></option>
        <% }); %>
      </select>
    </div>
    <% } %>

    <div class="form-group">
      <label class="custom-checkbox">
        <input type="checkbox" id="mustChangePasswordModify" name="mustChangePassword" value="TRUE" <%= account.attrs.zimbraPasswordMustChange === 'TRUE' ? 'checked' : '' %>>
        <span class="checkmark"></span>
        <span class="checkbox-text">Wajibkan Mengubah Password Saat Login Berikutnya (zimbraPasswordMustChange)</span>
      </label>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Simpan Perubahan</button>
  </form>
</div>

<!-- Reset Password -->
<div class="section">
  <h3>Reset Password Akun</h3>
  <form method="POST" action="/accounts/<%= encodeURIComponent(account.name) %>/password" class="form-card compact">
    <div class="form-group">
      <label for="newPassword">Password Baru</label>
      <div class="password-group-row">
        <div class="input-icon-wrapper flex-1">
          <span class="input-icon">🔒</span>
          <input type="password" id="newPassword" name="newPassword" placeholder="Minimal 6 karakter" required minlength="6">
          <button type="button" class="btn-input-action" onclick="togglePasswordVisibility('newPassword')" title="Tampilkan Password">👁️</button>
        </div>
        <button type="button" class="btn btn-secondary btn-generate-pill" onclick="generateResetPassword()">
          🎲 Acak Password
        </button>
      </div>
    </div>

    <div class="form-group">
      <label class="custom-checkbox">
        <input type="checkbox" id="mustChangePasswordReset" name="mustChangePassword" value="TRUE">
        <span class="checkmark"></span>
        <span class="checkbox-text">Wajibkan Pengguna Mengubah Password Baru Saat Login Berikutnya</span>
      </label>
    </div>

    <button type="submit" class="btn btn-warning btn-block" onclick="return confirm('Yakin ingin reset password akun ini?')">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.778-7.778zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
      </svg>
      <span>Reset Password Sekarang</span>
    </button>
  </form>
</div>

<!-- Danger Zone -->
<div class="section danger-zone">
  <h3>Zona Bahaya</h3>
  <div class="form-card compact danger">
    <p class="danger-text">⚠️ Menghapus akun akan memusnahkan semua data email & akun secara permanen dan tidak dapat dibatalkan.</p>
    <button type="button" class="btn btn-danger btn-block" onclick="showDeleteModal()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 6 5 6 21 6"></polyline>
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        <line x1="10" y1="11" x2="10" y2="17"></line>
        <line x1="14" y1="11" x2="14" y2="17"></line>
      </svg>
      <span>Hapus Akun Ini</span>
    </button>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display:none;">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Konfirmasi Hapus Akun</h3>
    </div>
    <div class="modal-body">
      <p class="danger-text">
        Ketik alamat email lengkap <strong><%= account.name %></strong> di bawah untuk mengonfirmasi penghapusan:
      </p>
      <div class="form-group">
        <input type="text" id="confirmEmailInput" placeholder="Ketik email untuk konfirmasi" autocomplete="off" oninput="checkDeleteConfirm()">
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">Batal</button>
      <form id="deleteForm" method="POST" action="/accounts/<%= encodeURIComponent(account.name) %>/delete" style="display:inline;">
        <input type="hidden" name="confirmEmail" id="confirmEmailField">
        <button type="submit" class="btn btn-danger" id="deleteBtn" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <span>Hapus Sekarang</span>
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Delete Alias Confirmation Modal -->
<div id="deleteAliasModal" class="modal" style="display:none;">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Konfirmasi Hapus Email Alias</h3>
    </div>
    <div class="modal-body">
      <p class="danger-text">
        Tindakan ini akan menghapus alias email secara permanen dari akun ini. Ketik alamat alias <strong id="targetAliasText" style="color: var(--danger); font-family: monospace; font-size: 14px;"></strong> di bawah ini untuk mengonfirmasi:
      </p>
      <div class="form-group" style="margin-top: 14px;">
        <input type="text" id="confirmAliasInput" placeholder="Ketik persis alamat alias..." autocomplete="off" oninput="checkDeleteAliasConfirm()">
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" onclick="closeDeleteAliasModal()">Batal</button>
      <form id="deleteAliasForm" method="POST" action="/accounts/<%= encodeURIComponent(account.name) %>/alias/remove" style="display:inline;">
        <input type="hidden" name="alias" id="deleteAliasTargetField">
        <input type="hidden" name="confirmAlias" id="confirmAliasField">
        <button type="submit" class="btn btn-danger" id="deleteAliasBtn" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <span>Hapus Alias</span>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
const ACCOUNT_NAME = '<%= account.name %>';
let currentTargetAlias = '';

function showDeleteAliasModal(alias) {
  currentTargetAlias = alias;
  document.getElementById('targetAliasText').innerText = alias;
  document.getElementById('deleteAliasTargetField').value = alias;
  document.getElementById('confirmAliasInput').value = '';
  document.getElementById('confirmAliasField').value = '';
  document.getElementById('deleteAliasBtn').disabled = true;
  document.getElementById('deleteAliasModal').style.display = 'flex';
  setTimeout(() => {
    document.getElementById('confirmAliasInput').focus();
  }, 100);
}

function closeDeleteAliasModal() {
  document.getElementById('deleteAliasModal').style.display = 'none';
  document.getElementById('confirmAliasInput').value = '';
  document.getElementById('confirmAliasField').value = '';
  document.getElementById('deleteAliasBtn').disabled = true;
  currentTargetAlias = '';
}

function checkDeleteAliasConfirm() {
  const input = document.getElementById('confirmAliasInput').value.trim();
  const match = input.toLowerCase() === currentTargetAlias.toLowerCase();
  document.getElementById('deleteAliasBtn').disabled = !match;
  document.getElementById('confirmAliasField').value = match ? input : '';
}

function generateResetPassword() {
  const uppers = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const lowers = 'abcdefghijklmnopqrstuvwxyz';
  const digits = '0123456789';
  const symbols = '!@#$%^&*';
  
  let pw = '';
  pw += uppers.charAt(Math.floor(Math.random() * uppers.length));
  pw += uppers.charAt(Math.floor(Math.random() * uppers.length));
  pw += lowers.charAt(Math.floor(Math.random() * lowers.length));
  pw += lowers.charAt(Math.floor(Math.random() * lowers.length));
  pw += digits.charAt(Math.floor(Math.random() * digits.length));
  pw += digits.charAt(Math.floor(Math.random() * digits.length));
  pw += symbols.charAt(Math.floor(Math.random() * symbols.length));
  pw += symbols.charAt(Math.floor(Math.random() * symbols.length));
  
  const all = uppers + lowers + digits + symbols;
  for (let i = 0; i < 4; i++) {
    pw += all.charAt(Math.floor(Math.random() * all.length));
  }
  
  pw = pw.split('').sort(() => 0.5 - Math.random()).join('');
  
  const input = document.getElementById('newPassword');
  input.type = 'text';
  input.value = pw;
}

function togglePasswordVisibility(id) {
  const input = document.getElementById(id);
  if (input) {
    input.type = input.type === 'password' ? 'text' : 'password';
  }
}

function showDeleteModal() {
  document.getElementById('deleteModal').style.display = 'flex';
  document.getElementById('confirmEmailInput').value = '';
  document.getElementById('confirmEmailInput').focus();
  document.getElementById('deleteBtn').disabled = true;
}

function closeDeleteModal() {
  document.getElementById('deleteModal').style.display = 'none';
  document.getElementById('confirmEmailInput').value = '';
  document.getElementById('confirmEmailField').value = '';
  document.getElementById('deleteBtn').disabled = true;
}

function checkDeleteConfirm() {
  const input = document.getElementById('confirmEmailInput').value;
  const match = input === ACCOUNT_NAME;
  document.getElementById('deleteBtn').disabled = !match;
  document.getElementById('confirmEmailField').value = match ? input : '';
}
</script>

</div> <!-- End detail-page-container -->

<%- include('../partials/footer') %>
